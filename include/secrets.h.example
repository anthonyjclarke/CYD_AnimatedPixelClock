#pragma once

/*
 * CYD_AnimatedPixelClock - Secrets
 *
 * Copy this file to include/secrets.h and fill in your own values.
 * include/secrets.h is gitignored and must NEVER be committed.
 *
 * Everything here is optional. With no secrets.h at all the device provisions
 * WiFi through the WiFiManager captive portal (SSID "PixelClock-Setup") or
 * Improv-Serial over USB, which is the normal path.
 */

// ---- Optional hardcoded WiFi ----
// Only needed for modules whose AP mode is faulty. Leave undefined to use the
// captive portal. Defining these skips provisioning entirely.
// #define SECRET_WIFI_SSID "YourNetwork"
// #define SECRET_WIFI_PASS "YourPassword"

// ---- Optional OTA / web UI password ----
// #define SECRET_OTA_PASSWORD "changeme"

// ---- Optional commercial weather API key ----
// The Weather clock uses the free Open-Meteo endpoint by default and needs no
// key. Set one only if you have a commercial subscription.
