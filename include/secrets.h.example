#pragma once

/*
 * CYD_AnimatedPixelClock - Secrets
 *
 * Copy this file to include/secrets.h and fill in your own values. That file is
 * gitignored and must never be committed. include/config.h includes it
 * automatically when it exists - no other change is needed.
 *
 * Everything here is optional. Without a secrets.h the device provisions WiFi
 * through the WiFiManager captive portal (SSID "PixelClock-Setup") or over USB
 * with Improv-Serial, which is the normal path.
 */

// ---- Optional hardcoded WiFi ----
// Only needed for a module whose access-point mode is faulty. Defining these
// skips the captive portal; if the connection fails the portal starts anyway.
