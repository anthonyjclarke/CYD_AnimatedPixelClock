# ---- Archive: kept on disk for provenance, but its compiled payloads are not
#      committed. ~90MB of ESP32-S3 firmware images and Windows executables that
#      cannot run on a CYD would otherwise live in this repository forever.
#      archive/README.md documents what each folder holds.
archive/upstream-release/release/
archive/upstream-docs/docs/firmware/
archive/pc-companion/PC-Companion-App-v4/win-companion/dist/
*.exe

# NOTE: CHANGELOG.md, CLAUDE.md and the rest of archive/ are tracked deliberately.
.vscode/extensions.json
